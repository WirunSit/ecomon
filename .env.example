# ตัวอย่างค่าตั้งของ server — ใส่ในหน้าตั้งค่า Environment ของผู้ให้บริการ หรือ docker run -e (server ไม่อ่านไฟล์ .env เอง) · ดู docs/DEPLOY.md
NODE_ENV=production
PORT=8080
# ไฟล์ฐานข้อมูล SQLite ต้องอยู่บนดิสก์ถาวร (volume) ไม่งั้นข้อมูลหายตอน deploy ใหม่
DATABASE_PATH=/data/ecomon.sqlite
# รหัสเชิญสำหรับสมัครบัญชีครู (ตั้งเป็นข้อความยาวที่เดายาก แล้วบอกเฉพาะครู) ไม่ตั้ง = ปิดการสมัครครู
TEACHER_INVITE_CODE=
# สร้างห้องเรียนนี้อัตโนมัติตอนเริ่ม (ไม่จำเป็น ครูสร้างห้องเองได้ในหน้าครู)
SEED_CLASS_CODE=
# ถ้า client อยู่คนละโดเมนกับ server ใส่ origin ของ client (คั่นด้วย ,) — บริการเดียวไม่ต้องตั้ง
CLIENT_ORIGIN=*
# 1 = ใช้คำถามทั้งหมดทันที (ร่าง + อนุมัติแล้ว ครูกด "ถอนออก" ข้อที่ไม่ต้องการได้) · 0 = ใช้เฉพาะข้อที่ครูอนุมัติ
INCLUDE_DRAFT_QUESTIONS=1
# 0 = ปิดตัวจับเวลาทั้ง server (ครูปิดรายห้องได้ในหน้าครูอยู่แล้ว)
QUESTION_TIMER=1
# โหมดทดสอบ (ให้ key item / เรียกมอนป่า) ห้ามเปิดตอนใช้จริง
DEV_TOOLS=0
# login ได้กี่ครั้งต่อ IP ใน 5 นาที (ทั้งโรงเรียนมักใช้ IP เดียว)
LOGIN_PER_IP_PER_5MIN=400
# 0 = ไม่เสิร์ฟหน้าเกมจาก server (กรณีวาง client ไว้ที่ Netlify/Vercel)
SERVE_CLIENT=1
# สำรอง/กู้ฐานข้อมูลอัตโนมัติไป GitHub Release ของ repo ส่วนตัว — จำเป็นบน Render ฟรี (ไม่มีดิสก์ถาวร) · ว่าง = ปิด
BACKUP_GITHUB_REPO=
# fine-grained token: Contents Read and write เฉพาะ repo ข้างบน (ใส่ในหน้า Environment ของผู้ให้บริการเท่านั้น)
BACKUP_GITHUB_TOKEN=
BACKUP_INTERVAL_MIN=5
BACKUP_KEEP=10
